# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=osticket
MYSQL_USER=osticket
MYSQL_PASSWORD=osticket
MYSQL_HOST_PORT=3307

# Web (osTicket UI on http://localhost:8080)
